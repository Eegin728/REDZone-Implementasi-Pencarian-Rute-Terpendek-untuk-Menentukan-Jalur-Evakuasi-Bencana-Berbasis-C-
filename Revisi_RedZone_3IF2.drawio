        <mxCell id="qsDFnlpI3uqCZHhdEycU-142" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;align=center;" value="&lt;p&gt;&lt;b&gt;Masyarakat:&lt;/b&gt; Memasukkan lokasi berdasarkan titik awal yang telah disediakan, diikuti verifikasi dua langkah guna memastikan keakuratan posisi sebelum sistem memproses jalur evakuasi.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Admin:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Memasukkan detail-detail jalan dari titik awal menuju titik evakuasi, beserta jarak antar titik, serta catatan pada setiap jalur&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="97" width="584" x="4707.13" y="70" as="geometry" />
        </mxCell>
        <mxCell id="qsDFnlpI3uqCZHhdEycU-143" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="Pola Output Informasi" vertex="1">
          <mxGeometry height="60" width="120" x="4538.25" y="331" as="geometry" />
