        <mxCell id="qsDFnlpI3uqCZHhdEycU-151" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;align=center;" value="&lt;p style=&quot;&quot;&gt;Masyarakat: Memilih aksi berupa (1: Titik Awal)&lt;/p&gt;&lt;p style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Admin:&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt; Memilih menu manajemen bencana (&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;1. Tambah Data Kelurahan dan titik Acuan Baru :&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;2.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Update status ruas jalan&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;3.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp;Lihat Daftar Kelurahan &amp;amp; Data Saat Ini&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp;: 4. keluar&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.)&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="97" width="584" x="4707" y="-40" as="geometry" />
        </mxCell>
        <mxCell id="qsDFnlpI3uqCZHhdEycU-152" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="&lt;p&gt;&lt;b&gt;Masyarakat:&lt;/b&gt;&amp;nbsp;Memetakan titik awal dari kelurahan pengguna menuju titik evakuasi terdekat berdasarkan aturan rute aman yang tersimpan di sistem, serta menghitung estimasi waktu perjalanan.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Admin:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Memperbarui aturan rute dan status kelayakan jalan pada basis data agar jalur yang mengarah ke lokasi rawan lahar tidak direkomendasikan oleh sistem.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="116" width="584" x="4706" y="182" as="geometry" />
        </mxCell>
